    <ItemGroup>
        <InternalsVisibleTo Include="Alexandria.Tests.Unit"/>
        <InternalsVisibleTo Include="Alexandria.Tests.Integration"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alexandria.Common\Alexandria.Common.csproj"/>
        <ProjectReference Include="..\Alexandria.Data.Models\Alexandria.Data.Models.csproj"/>
    </ItemGroup>

