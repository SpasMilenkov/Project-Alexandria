<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED "">
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED "" domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  Replaces the distribution policy in the media worker image. ImageMagick only runs as the
  out-of-process fallback decoder for image formats libvips cannot load, so everything not
  needed for "decode an allowlisted format, write a PNG to stdout" is denied. The worker also
  passes matching -limit flags and wraps the process in prlimit; these values are the ceiling.
-->
<policymap>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="list-length" value="64"/>
  <policy domain="resource" name="time" value="60"/>
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="resource" name="file" value="64"/>
  <policy domain="resource" name="temporary-path" value="/tmp/worker-scratch"/>
  <policy domain="system" name="max-memory-request" value="256MiB"/>
  <policy domain="system" name="precision" value="6"/>

  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="module" rights="none" pattern="{PS,PS2,PS3,EPS,PDF,XPS,SVG,MSVG,MVG,MSL,URL,TEXT,LABEL,CAPTION,EPHEMERAL,SHOW,WIN,X,PLT,HTML}"/>

  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="{BMP,BMP2,BMP3,DIB,TGA,ICB,VDA,VST,QOI,HEIC,HEIF,AVIF,PSD,PSB,ICO,ICON,CUR,PCX,DCX,DDS,DXT1,DXT5,JP2,J2K,JPC,TIFF,TIF,TIFF64,PNM,PBM,PGM,PPM,PAM}"/>
  <policy domain="coder" rights="write" pattern="PNG"/>
</policymap>
