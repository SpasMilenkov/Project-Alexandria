# Alexandria Garage S3 storage — generated by the Alexandria Installer
# on {{GENERATED_AT}}. Secrets below were produced for this installation.

metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"

db_engine = "lmdb"

# Single-node local setup
replication_factor = 1

s3_region = "garage"

compression_level = 0
block_size = "4M"
block_max_concurrent_writes_per_request = 32

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "garage:3901"

rpc_secret = "{{RPC_SECRET}}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"

admin_token = "{{ADMIN_TOKEN}}"
metrics_token = "{{METRICS_TOKEN}}"
