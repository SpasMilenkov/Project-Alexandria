  media-metadata-worker:
    build:
      context: {{SOURCE_ROOT}}/Backend
      dockerfile: Alexandria.Workers.MediaMetadata/Dockerfile
    container_name: alexandria-media-metadata-worker
    labels:
      - "logs.collect=true"
    restart: always

    volumes:
      - media_metadata_worker_scratch:/tmp/worker-scratch
      - media_audio_data:/data

    environment:
      Serilog__MinimumLevel__Default: Information
      Serilog__MinimumLevel__Override__Microsoft.AspNetCore: Warning
      Serilog__MinimumLevel__Override__System: Warning
      DOTNET_ENVIRONMENT: Production
      ConnectionStrings__AlexandriaPostgres: ${DB_CONNECTION_STRING:?DB_CONNECTION_STRING is required}
      S3Storage__Provider: Garage
      S3Storage__Endpoint: http://garage:3900
      S3Storage__Region: garage
      S3Storage__UploadBucket: alexandria-files
      S3Storage__PreviewBucket: alexandria-previews
      S3Storage__TempBucket: alexandria-temp
      S3Storage__ImagesBucket: alexandria-images
      S3Storage__StreamingBucket: alexandria-streaming
      S3Storage__ProviderSettings__Garage__Region: garage
      S3Storage__ProviderSettings__Garage__ForcePathStyle: "true"
      S3Storage__AccessKey: ${GARAGE_S3_WORKER_ACCESS_KEY:?GARAGE_S3_WORKER_ACCESS_KEY is required}
      S3Storage__SecretKey: ${GARAGE_S3_WORKER_SECRET_KEY:?GARAGE_S3_WORKER_SECRET_KEY is required}
      S3Storage__PublicEndpoint: ${GARAGE_S3_PUBLIC_ENDPOINT:?GARAGE_S3_PUBLIC_ENDPOINT is required}
      RabbitMQ__HostName: rabbitmq
      RabbitMQ__UserName: ${RABBITMQ_MEDIA_METADATA_WORKER:?RABBITMQ_MEDIA_METADATA_WORKER is required}
      RabbitMQ__Password: ${MEDIA_METADATA_WORKER_RABBITMQ_PASSWORD:?MEDIA_METADATA_WORKER_RABBITMQ_PASSWORD is required}
      RabbitMQ__VirtualHost: ${RABBITMQ_VHOST:-alexandria}
      RabbitMQ__Consumer__ExchangeName: content-exchange
      RabbitMQ__Consumer__TriggerQueueName: media-metadata-trigger-queue
      RabbitMQ__Consumer__ResultsQueueName: media-metadata-results-queue
      Features__Autotagging: "${AUTOTAGGING_ENABLED:-false}"
      Essentia__Backbone: ${ESSENTIA_BACKBONE:?ESSENTIA_BACKBONE is required}
      Essentia__StagedDir: /data/staged
      Essentia__OutputDir: /data/output
      Essentia__LocalVolumePath: /data
      Essentia__VolumeMountPath: /data
      Features__AudioAnalysis: "${AUDIO_ANALYSIS_ENABLED:-false}"
      ASPNETCORE_URLS: http://+:8080
      TMPDIR: /tmp/worker-scratch

    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      garage:
        condition: service_healthy
      rabbitmq-config:
        condition: service_completed_successfully

    networks:
      - data-net

    healthcheck:
      test: ["CMD", "dotnet", "Alexandria.Workers.MediaMetadata.dll", "--healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "5"

    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M
