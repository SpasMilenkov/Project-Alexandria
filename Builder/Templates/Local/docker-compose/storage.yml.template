  postgres:
    image: postgres:16-alpine
    container_name: alexandria-local-postgres
    restart: unless-stopped

    environment:
      POSTGRES_DB: alexandria_dev
      POSTGRES_USER: alexandria_user
      POSTGRES_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD is required}
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=en_US.UTF-8"
      POSTGRES_EXPORTER_PASSWORD: ${POSTGRES_EXPORTER_PASSWORD:?POSTGRES_EXPORTER_PASSWORD is required}

    volumes:
      - postgres_local_data:/var/lib/postgresql/data
      - {{SOURCE_ROOT}}/scripts/postgres/init:/docker-entrypoint-initdb.d:ro

    networks:
      - data-net

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U alexandria_user -d alexandria_dev"]
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 10s

  garage:
    image: dxflrs/garage:v2.2.0
    container_name: alexandria-local-garage
    restart: unless-stopped

    environment:
      RUST_LOG: garage=info

    volumes:
      - ./garage.toml:/etc/garage.toml
      - garage_local_meta_data:/var/lib/garage/meta
      - garage_local_storage_data:/var/lib/garage/data

    networks:
      - app-net # nginx proxies S3 requests from browser
      - data-net # api and workers talk to it directly

    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M

    healthcheck:
      test: ["CMD", "/garage", "status"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s

  garage-init:
    build:
      context: {{SOURCE_ROOT}}
      dockerfile: scripts/garage-init/Dockerfile
    container_name: alexandria-garage-init
    restart: no

    depends_on:
      garage:
        condition: service_healthy

    environment:
      CORS_ORIGIN: ${CORS_ORIGIN:-http://localhost:5173}

    volumes:
      - ./garage.toml:/etc/garage.toml:ro
      - garage_local_meta_data:/var/lib/garage/meta
      - ./init-output:/output
      - {{SOURCE_ROOT}}/scripts/garage-init/cors.json:/config/cors.json:ro

    networks:
      - data-net

  rabbitmq-config:
    image: alpine:3.20
    container_name: alexandria-rabbitmq-config
    restart: "no"

    environment:
      RABBITMQ_USER: ${RABBITMQ_USER:?RABBITMQ_USER is required}
      RABBITMQ_PASS: ${RABBITMQ_PASSWORD:?RABBITMQ_PASSWORD is required}
      API_RABBITMQ_USER: ${API_RABBITMQ_USER:?API_RABBITMQ_USER is required}
      API_RABBITMQ_PASS: ${API_RABBITMQ_PASSWORD:?API_RABBITMQ_PASSWORD is required}
      RABBITMQ_VHOST: ${RABBITMQ_VHOST:-alexandria}
      DOCUMENT_WORKER_PASS: ${DOCUMENT_WORKER_RABBITMQ_PASSWORD:?DOCUMENT_WORKER_RABBITMQ_PASSWORD is required}
      MEDIA_WORKER_PASS: ${MEDIA_WORKER_RABBITMQ_PASSWORD:?MEDIA_WORKER_RABBITMQ_PASSWORD is required}
      TRANSPILATION_WORKER_PASS: ${TRANSPILATION_WORKER_RABBITMQ_PASSWORD:?TRANSPILATION_WORKER_RABBITMQ_PASSWORD is required}
      MEDIA_METADATA_WORKER_PASS: ${MEDIA_METADATA_WORKER_RABBITMQ_PASSWORD:?MEDIA_METADATA_WORKER_RABBITMQ_PASSWORD is required}
      LYRICS_WORKER_PASS: ${LYRICS_WORKER_RABBITMQ_PASSWORD:?LYRICS_WORKER_RABBITMQ_PASSWORD is required}
      ESSENTIA_WORKER_PASS: ${ESSENTIA_WORKER_RABBITMQ_PASSWORD:?ESSENTIA_WORKER_RABBITMQ_PASSWORD is required}

    volumes:
      - {{SOURCE_ROOT}}/rabbitmq/definitions.template.json:/template/definitions.template.json:ro
      - rabbitmq_definitions:/output
    entrypoint: ["/bin/sh", "-c"]
    command:
      - apk add --no-cache gettext > /dev/null && envsubst < /template/definitions.template.json > /output/definitions.json

  rabbitmq:
    image: rabbitmq:4.2.5-management-alpine
    container_name: alexandria-local-rabbitmq
    restart: unless-stopped

    depends_on:
      rabbitmq-config:
        condition: service_completed_successfully

    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER:-dev_admin}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD:?RABBITMQ_PASSWORD is required}
      RABBITMQ_DEFAULT_VHOST: ${RABBITMQ_VHOST:-alexandria}
      RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS: -rabbit log_levels [{connection,error},{default,error}] disk_free_limit 2147483648

    volumes:
      - rabbitmq_local_data:/var/lib/rabbitmq
      - {{SOURCE_ROOT}}/rabbitmq/rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro
      - {{SOURCE_ROOT}}/rabbitmq/enabled_plugins:/etc/rabbitmq/enabled_plugins:ro
      - rabbitmq_definitions:/etc/rabbitmq/definitions:ro

    networks:
      - data-net
{{RABBITMQ_ESSENTIA_NET}}

    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "check_port_connectivity"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
