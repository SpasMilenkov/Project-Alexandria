  essentia-effnet-worker:
    build:
      context: {{SOURCE_ROOT}}/classificators/essentia
      dockerfile: Dockerfile
    container_name: alexandria-essentia-effnet
    restart: unless-stopped

    environment:
      RABBITMQ_URL: ${ESSENTIA_RABBITMQ_URL:?ESSENTIA_RABBITMQ_URL is required}
      EXCHANGE_NAME: content-exchange
      RESULT_ROUTING_KEY: media-metadata.completed
      QUEUE_NAME: classify-effnet-queue
      BACKBONE: effnet
      ESSENTIA_MODEL_DIR: /app/models
      VERIFY_MODELS: "true"
      PREFETCH_COUNT: "1"
      ESSENTIA_IDLE_UNLOAD_SECONDS: "${ESSENTIA_IDLE_UNLOAD_SECONDS:-300}"
      PYTHONDONTWRITEBYTECODE: "1"
      HOME: /tmp
      # TensorFlow and OpenMP size their pools from the host's cores, not the CPU cap.
      TF_NUM_INTRAOP_THREADS: "${LIMIT_ESSENTIA_EFFNET_WORKER_CPUS:-4}"
      TF_NUM_INTEROP_THREADS: "1"
      OMP_NUM_THREADS: "${LIMIT_ESSENTIA_EFFNET_WORKER_CPUS:-4}"

    volumes:
      - ./models:/app/models:ro
      - media_audio_data:/data

    depends_on:
      rabbitmq:
        condition: service_healthy

    networks:
      - essentia-net

    # Swap capped at the memory cap, so hitting it restarts the container instead of
    # pushing the host into swap.
    memswap_limit: ${LIMIT_ESSENTIA_EFFNET_WORKER_MEMORY:-2048M}
    deploy:
      resources:
        limits:
          cpus: "${LIMIT_ESSENTIA_EFFNET_WORKER_CPUS:-4}"
          memory: ${LIMIT_ESSENTIA_EFFNET_WORKER_MEMORY:-2048M}
