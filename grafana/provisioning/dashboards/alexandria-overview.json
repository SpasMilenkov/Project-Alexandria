{
  "uid": "alexandria-overview",
  "title": "Alexandria overview",
  "description": "Scrape availability, selected installation containers, database activity and broker backlog. Metrics retention is up to 15 days or 2 GB; logs are retained for 14 days. cAdvisor requires host access and reports this Compose project only.",
  "id": null,
  "tags": [
    "alexandria"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "url": "/monitoring/d/alexandria-overview",
