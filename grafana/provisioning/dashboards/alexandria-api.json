      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "alexandria-prometheus"
          },
          "expr": "sum(rate(process_cpu_time_seconds_total{job=\"alexandria-api\"}[$__rate_interval]))",
          "legendFormat": "CPU cores",
          "refId": "A"
        }
      ]
    }
  ]
}
