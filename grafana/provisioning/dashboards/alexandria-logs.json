{
  "uid": "alexandria-logs",
  "title": "Alexandria logs",
  "description": "Opted-in API and worker logs for this Compose project. Supports plain Serilog console levels and structured Serilog JSON. Loki retains logs for 14 days; the time range may extend beyond available data.",
  "id": null,
  "tags": [
    "alexandria"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "url": "/monitoring/d/alexandria-overview",
      "type": "link"
    },
    {
      "title": "API",
      "url": "/monitoring/d/alexandria-api",
      "type": "link"
    },
    {
      "title": "Logs",
      "url": "/monitoring/d/alexandria-logs",
      "type": "link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "alexandria-loki"
        },
        "query": "label_values(service)",
        "definition": "label_values(service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log lines per second",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "alexandria-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "alexandria-loki"
          },
          "expr": "sum by (service) (rate({service=~\"${service:regex}\"}[$__auto]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors and fatal events",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "alexandria-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "alexandria-loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"${service:regex}\",level=~\"ERR|FTL|Error|Fatal\"}[$__auto]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "alexandria-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "alexandria-loki"
          },
          "expr": "{service=~\"${service:regex}\"} |= ${search:doublequote}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
