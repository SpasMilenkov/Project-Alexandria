{
  "rabbit_version": "3.13.0",
  "vhosts": [
    { "name": "${RABBITMQ_VHOST}" }
  ],
  "users": [
    { "name": "${RABBITMQ_USER}", "password": "${RABBITMQ_PASS}", "tags": "administrator" },
    { "name": "api_user", "password": "${API_RABBITMQ_PASS}", "tags": "" },
    { "name": "document_worker_user", "password": "${DOCUMENT_WORKER_PASS}", "tags": "" },
    { "name": "media_worker_user", "password": "${MEDIA_WORKER_PASS}", "tags": "" },
    { "name": "media_transpilation_worker", "password": "${TRANSPILATION_WORKER_PASS}", "tags": "" },
    { "name": "lyrics_worker_user", "password": "${LYRICS_WORKER_PASS}", "tags": "" },
    { "name": "media_metadata_worker_user", "password": "${MEDIA_METADATA_WORKER_PASS}", "tags": "" },
    { "name": "essentia_worker_user", "password": "${ESSENTIA_WORKER_PASS}", "tags": "" }
  ],
  "permissions": [
    {
      "user": "${RABBITMQ_USER}",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "api_user",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^content-exchange$",
      "write": "^content-exchange$",
      "read": "^$"
    },
    {
      "user": "document_worker_user",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^(content-exchange|document-queue)$",
      "write": "^(content-exchange|document-queue)$",
      "read": "^(content-exchange|document-queue)$"
    },
    {
      "user": "media_worker_user",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^(content-exchange|media-queue)$",
      "write": "^(content-exchange|media-queue)$",
      "read": "^(content-exchange|media-queue)$"
    },
    {
      "user": "media_transpilation_worker",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^(content-exchange|transpilation-queue)$",
      "write": "^(content-exchange|transpilation-queue)$",
      "read": "^(content-exchange|transpilation-queue)$"
    },
    {
      "user": "lyrics_worker_user",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^(content-exchange|lyrics-queue)$",
      "write": "^(content-exchange|lyrics-queue)$",
      "read": "^(content-exchange|lyrics-queue)$"
    },
    {
      "user": "media_metadata_worker_user",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^(content-exchange|media-metadata-results-queue|media-metadata-trigger-queue)$",
      "write": "^(content-exchange|media-metadata-results-queue|media-metadata-trigger-queue)$",
      "read": "^(content-exchange|media-metadata-results-queue|media-metadata-trigger-queue)$"
    },
    {
      "user": "essentia_worker_user",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^(content-exchange|classify-effnet-queue|classify-maest-queue)$",
      "write": "^content-exchange$",
      "read": "^(classify-effnet-queue|classify-maest-queue)$"
    }
  ],
  "exchanges": [
    {
      "name": "content-exchange",
      "vhost": "${RABBITMQ_VHOST}",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    { "name": "document-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "media-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "transpilation-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "lyrics-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "classify-effnet-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "classify-maest-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "media-metadata-results-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "media-metadata-trigger-queue", "vhost": "${RABBITMQ_VHOST}", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "document-queue", "destination_type": "queue", "routing_key": "document.#", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "media-queue", "destination_type": "queue", "routing_key": "media.#", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "media-queue", "destination_type": "queue", "routing_key": "image.#", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "transpilation-queue", "destination_type": "queue", "routing_key": "transpilation.#", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "lyrics-queue", "destination_type": "queue", "routing_key": "lyrics.#", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "classify-effnet-queue", "destination_type": "queue", "routing_key": "media-metadata.classify.audio.effnet", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "classify-maest-queue", "destination_type": "queue", "routing_key": "media-metadata.classify.audio.maest", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "media-metadata-results-queue", "destination_type": "queue", "routing_key": "media-metadata.completed.#", "arguments": {} },
    { "source": "content-exchange", "vhost": "${RABBITMQ_VHOST}", "destination": "media-metadata-trigger-queue", "destination_type": "queue", "routing_key": "media-metadata.enrich.#", "arguments": {} }
  ]
}
